# Copy to .env.local (or set these in your host's environment) to change the
# defaults. Nothing here is needed to run the shop locally. The app and the
# npm scripts (setup, db:demo, admin:create) both read these files.
#
# On Vercel, adding Turso and Blob in the project's Storage tab sets the
# hosted variables for you; `vercel env pull .env.local` copies them here.

# Database. Default: a SQLite file in data/. Hosted: a Turso (libSQL) database,
# either by hand here or as TURSO_DATABASE_URL + TURSO_AUTH_TOKEN from Vercel.
DATABASE_URL=file:data/shakha.db
# DATABASE_AUTH_TOKEN=
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Product photos. Default: files in UPLOAD_DIR (use a persistent disk in
# production). With a Vercel Blob store connected they go to Blob instead.
UPLOAD_DIR=data/uploads
# BLOB_READ_WRITE_TOKEN=
