# Copy to .env.local (or set these in your host's environment) to change the
# defaults. Nothing here is needed to run the shop locally. The app and the
# npm scripts (setup, db:demo, admin:create) both read these files.

# Database. Default: a SQLite file in data/. For Turso or another libSQL
# server use its URL, e.g. libsql://<database>-<org>.turso.io, plus a token.
DATABASE_URL=file:data/shakha.db
# DATABASE_AUTH_TOKEN=

# Where uploaded product photos are kept. Use a persistent disk in production.
UPLOAD_DIR=data/uploads
